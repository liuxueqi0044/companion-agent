  "models": {
    "ActionReceipt": {
      "$defs": {
        "TaskSnapshot": {
          "additionalProperties": false,
          "properties": {
            "attempt_count": {
              "minimum": 1,
              "title": "Attempt Count",
              "type": "integer"
            },
            "created_at": {
              "format": "date-time",
              "title": "Created At",
              "type": "string"
            },
            "current_attempt_id": {
              "title": "Current Attempt Id",
              "type": "string"
            },
            "error_code": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Error Code"
            },
            "executor": {
              "const": "local_csv_audit",
              "default": "local_csv_audit",
              "title": "Executor",
              "type": "string"
            },
            "input_hash": {
              "title": "Input Hash",
              "type": "string"
            },
            "last_seq": {
              "minimum": 1,
              "title": "Last Seq",
              "type": "integer"
            },
            "profile_id": {
              "title": "Profile Id",
              "type": "string"
            },
            "profile_revision": {
              "exclusiveMinimum": 0,
              "title": "Profile Revision",
              "type": "integer"
            },
            "requirements_interpretation": {
              "const": "not_run",
              "default": "not_run",
              "title": "Requirements Interpretation",
              "type": "string"
            },
            "schema_version": {
              "const": "local-task/1",
              "default": "local-task/1",
              "title": "Schema Version",
              "type": "string"
            },
            "status": {
              "enum": [
                "queued",
                "running",
                "cancelling",
                "completed",
                "failed",
                "cancelled",
                "interrupted"
              ],
              "title": "Status",
              "type": "string"
            },
            "task_id": {
              "title": "Task Id",
              "type": "string"
            },
            "tool_version": {
              "const": "csv_audit/1",
              "default": "csv_audit/1",
              "title": "Tool Version",
              "type": "string"
            },
            "updated_at": {
              "format": "date-time",
              "title": "Updated At",
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "profile_id",
            "profile_revision",
            "input_hash",
            "status",
            "created_at",
            "updated_at",
            "last_seq",
            "current_attempt_id",
            "attempt_count"
          ],
          "title": "TaskSnapshot",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "default": "applied",
          "enum": [
            "applied",
            "too_late",
            "already_requested",
            "replayed"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "task": {
          "$ref": "#/$defs/TaskSnapshot"
        }
      },
      "required": [
        "task"
