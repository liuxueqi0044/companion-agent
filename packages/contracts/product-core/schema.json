{
  "$defs": {
    "ArtifactAction": {
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/ArtifactFile"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "kind": {
          "const": "artifact.create",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "files"
      ],
      "title": "ArtifactAction",
      "type": "object"
    },
    "ArtifactFile": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "content"
      ],
      "title": "ArtifactFile",
      "type": "object"
    },
    "CapabilityCallAction": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        },
        "component": {
          "pattern": "^[a-zA-Z0-9_.-]{1,100}$",
          "title": "Component",
          "type": "string"
        },
        "kind": {
          "const": "capability.call",
          "title": "Kind",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Package Id",
          "type": "string"
        },
        "tool": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "package_id",
        "version",
        "component",
        "tool"
      ],
      "title": "CapabilityCallAction",
      "type": "object"
    },
    "CapabilityDescribeAction": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "pattern": "^[a-zA-Z0-9_.-]{1,100}$",
          "title": "Component",
          "type": "string"
        },
        "kind": {
          "const": "capability.describe",
          "title": "Kind",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Package Id",
          "type": "string"
        },
        "resource": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource"
        },
        "tool": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "package_id",
        "version",
        "component"
      ],
      "title": "CapabilityDescribeAction",
      "type": "object"
    },
    "CodeCheckEvidence": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 800,
          "title": "Detail",
          "type": "string"
        },
        "kind": {
          "enum": [
            "node_syntax",
            "python_syntax",
            "json_parse",
            "not_run"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "status",
        "detail"
      ],
      "title": "CodeCheckEvidence",
      "type": "object"
    },
    "CodeFileEvidence": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "CodeFileEvidence",
      "type": "object"
    },
    "CodingEvidence": {
      "additionalProperties": false,
      "properties": {
        "api_requests": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Api Requests",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/CodeCheckEvidence"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/CodeFileEvidence"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "kind": {
          "const": "claude-code",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "receipt_id": {
          "title": "Receipt Id",
          "type": "string"
        },
        "tool_calls": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "receipt_id",
        "model",
        "files",
        "checks",
        "tool_calls",
        "api_requests"
      ],
      "title": "CodingEvidence",
      "type": "object"
    },
    "ContactCompleteRequest": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "$ref": "#/$defs/FollowUpDecision"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ticket": {
          "title": "Ticket",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ticket",
        "decision"
      ],
      "title": "ContactCompleteRequest",
      "type": "object"
    },
    "ContactFailGenerationRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "provider_failed",
            "provider_timeout",
            "provider_invalid_output",
            "provider_aborted"
          ],
          "title": "Reason",
          "type": "string"
        },
        "ticket": {
          "title": "Ticket",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ticket",
        "reason"
      ],
      "title": "ContactFailGenerationRequest",
      "type": "object"
    },
    "ContactIdRequest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ContactIdRequest",
      "type": "object"
    },
    "ConversationListRequest": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "limit": {
          "default": 20,
          "maximum": 50,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        }
      },
      "title": "ConversationListRequest",
      "type": "object"
    },
    "ConversationTurnsRequest": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before"
        },
        "conversation_id": {
          "title": "Conversation Id",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "snapshot": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot"
        }
      },
      "required": [
        "conversation_id"
      ],
      "title": "ConversationTurnsRequest",
      "type": "object"
    },
    "CsvAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "csv.audit",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CsvAction",
      "type": "object"
    },
    "DataQueryAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "data.query",
          "title": "Kind",
          "type": "string"
        },
        "sql": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        },
        "title": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "sql"
      ],
      "title": "DataQueryAction",
      "type": "object"
    },
    "FailGenerationRequest": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "provider_failed",
            "provider_timeout",
            "provider_invalid_output",
            "provider_aborted"
          ],
          "title": "Reason",
          "type": "string"
        },
        "ticket": {
          "title": "Ticket",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "ticket",
        "reason"
      ],
      "title": "FailGenerationRequest",
      "type": "object"
    },
    "FollowUpDecision": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "send",
            "cancel",
            "defer"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        },
        "reason": {
          "enum": [
            "still_relevant",
            "resolved",
            "recent_contact",
            "not_useful",
            "later"
          ],
          "title": "Reason",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "disposition",
        "reason"
      ],
      "title": "FollowUpDecision",
      "type": "object"
    },
    "FollowUpSuggestion": {
      "additionalProperties": false,
      "properties": {
        "due_at": {
          "format": "date-time",
          "title": "Due At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "topic": {
          "enum": [
            "work",
            "daily",
            "wellbeing"
          ],
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "purpose",
        "due_at",
        "expires_at"
      ],
      "title": "FollowUpSuggestion",
      "type": "object"
    },
    "GoalCriterionReview": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "maximum": 5,
          "minimum": 0,
          "title": "Criterion",
          "type": "integer"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "criterion",
        "passed",
        "reason",
        "evidence_ids"
      ],
      "title": "GoalCriterionReview",
      "type": "object"
    },
    "GoalDispatchAction": {
      "additionalProperties": false,
      "properties": {
        "executor": {
          "default": "worker",
          "enum": [
            "worker",
            "claude"
          ],
          "title": "Executor",
          "type": "string"
        },
        "kind": {
          "const": "goal.dispatch",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task_id"
      ],
      "title": "GoalDispatchAction",
      "type": "object"
    },
    "GoalFinishAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "goal.finish",
          "title": "Kind",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "complete",
            "needs_input",
            "incomplete"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "outcome"
      ],
      "title": "GoalFinishAction",
      "type": "object"
    },
    "GoalPlanAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "goal.plan",
          "title": "Kind",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/GoalTaskSpec"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "tasks"
      ],
      "title": "GoalPlanAction",
      "type": "object"
    },
    "GoalReviewAction": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/GoalCriterionReview"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "kind": {
          "const": "goal.review",
          "title": "Kind",
          "type": "string"
        },
        "task_id": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "accept",
            "rework"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "task_id",
        "verdict",
        "checks"
      ],
      "title": "GoalReviewAction",
      "type": "object"
    },
    "GoalSubmitAction": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "const": "goal.submit",
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "summary",
        "evidence_ids"
      ],
      "title": "GoalSubmitAction",
      "type": "object"
    },
    "GoalTaskSpec": {
      "additionalProperties": false,
      "properties": {
        "criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "maxItems": 11,
          "title": "Depends On",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Id",
          "type": "string"
        },
        "instruction": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Instruction",
          "type": "string"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "instruction",
        "criteria"
      ],
      "title": "GoalTaskSpec",
      "type": "object"
    },
    "MemorySuggestion": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "work",
            "preferences",
            "goals"
          ],
          "title": "Category",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "category",
        "content"
      ],
      "title": "MemorySuggestion",
      "type": "object"
    },
    "ModelDecision": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "artifact.create": "#/$defs/ArtifactAction",
                "capability.call": "#/$defs/CapabilityCallAction",
                "capability.describe": "#/$defs/CapabilityDescribeAction",
                "csv.audit": "#/$defs/CsvAction",
                "data.query": "#/$defs/DataQueryAction",
                "goal.dispatch": "#/$defs/GoalDispatchAction",
                "goal.finish": "#/$defs/GoalFinishAction",
                "goal.plan": "#/$defs/GoalPlanAction",
                "goal.review": "#/$defs/GoalReviewAction",
                "goal.submit": "#/$defs/GoalSubmitAction",
                "profile.change": "#/$defs/ProfileAction",
                "reminder.create": "#/$defs/ReminderAction",
                "tool.run": "#/$defs/ToolRunAction",
                "tool.save": "#/$defs/ToolSaveAction"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/CsvAction"
              },
              {
                "$ref": "#/$defs/ProfileAction"
              },
              {
                "$ref": "#/$defs/ArtifactAction"
              },
              {
                "$ref": "#/$defs/ReminderAction"
              },
              {
                "$ref": "#/$defs/ToolSaveAction"
              },
              {
                "$ref": "#/$defs/ToolRunAction"
              },
              {
                "$ref": "#/$defs/DataQueryAction"
              },
              {
                "$ref": "#/$defs/CapabilityDescribeAction"
              },
              {
                "$ref": "#/$defs/CapabilityCallAction"
              },
              {
                "$ref": "#/$defs/GoalPlanAction"
              },
              {
                "$ref": "#/$defs/GoalDispatchAction"
              },
              {
                "$ref": "#/$defs/GoalSubmitAction"
              },
              {
                "$ref": "#/$defs/GoalReviewAction"
              },
              {
                "$ref": "#/$defs/GoalFinishAction"
              }
            ]
          },
          "maxItems": 2,
          "title": "Actions",
          "type": "array"
        },
        "followup": {
          "anyOf": [
            {
              "$ref": "#/$defs/FollowUpSuggestion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memories": {
          "items": {
            "$ref": "#/$defs/MemorySuggestion"
          },
          "maxItems": 5,
          "title": "Memories",
          "type": "array"
        },
        "outcome": {
          "default": "complete",
          "enum": [
            "complete",
            "needs_input",
            "incomplete"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "plan": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Plan",
          "type": "array"
        },
        "reply": {
          "title": "Reply",
          "type": "string"
        }
      },
      "required": [
        "reply"
      ],
      "title": "ModelDecision",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "daily_evaluation_limit": {
          "default": 3,
          "maximum": 100,
          "minimum": 1,
          "title": "Daily Evaluation Limit",
          "type": "integer"
        },
        "daily_limit": {
          "default": 1,
          "maximum": 20,
          "minimum": 1,
          "title": "Daily Limit",
          "type": "integer"
        },
        "end_minute": {
          "default": 1260,
          "exclusiveMaximum": 1440,
          "minimum": 0,
          "title": "End Minute",
          "type": "integer"
        },
        "memory_categories": {
          "items": {
            "enum": [
              "work",
              "preferences",
              "goals"
            ],
            "type": "string"
          },
          "title": "Memory Categories",
          "type": "array"
        },
        "memory_enabled": {
          "default": true,
          "title": "Memory Enabled",
          "type": "boolean"
        },
        "paused_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paused Until"
        },
        "proactive_enabled": {
          "default": false,
          "title": "Proactive Enabled",
          "type": "boolean"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "start_minute": {
          "default": 540,
          "exclusiveMaximum": 1440,
          "minimum": 0,
          "title": "Start Minute",
          "type": "integer"
        },
        "timezone": {
          "default": "UTC",
          "title": "Timezone",
          "type": "string"
        },
        "topics": {
          "items": {
            "enum": [
              "work",
              "daily",
