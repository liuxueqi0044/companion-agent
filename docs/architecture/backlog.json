            "官方登录完成且产品不接触订阅 token",
            "成果可回收",
            "不能读取额度时标未知",
            "记录版本和规则核查日期"
          ]
        },
        {
          "id": "M00.6",
          "title": "冻结接口草案并重估范围",
          "stage": "P0",
          "status": "todo",
          "depends_on": [
            "M00.3",
            "M00.4",
            "M00.5"
          ],
          "owner_paths": [
            "docs/decisions/",
            "tests/spikes/",
            "packages/contracts/"
          ],
          "inputs": "所有接入验证、05-contracts.md",
          "outputs": "v1 Schema、能力矩阵、选型 ADR 与调整后的工期",
          "reuse": [
            "Pydantic",
            "JSON Schema",
            "上游生成类型"
          ],
          "acceptance": [
            "失败路线有可执行替代方案",
            "原生协议字段与产品字段分开",
            "首版所需能力全部有验证入口"
          ]
        }
      ]
    },
