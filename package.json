{
  "name": "companion-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Morrow Personal AI — local runtime, replaceable interfaces and offline product validation",
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "build": "node tools/product.mjs build",
    "typecheck": "node tools/product.mjs typecheck",
    "check": "node tools/product.mjs check",
    "test": "node tools/product.mjs test",
    "test:unit": "node tools/product.mjs test",
    "test:node": "node tools/product.mjs test:node",
    "test:python": "node tools/product.mjs test:python",
    "build:legacy": "npm run build --workspace @companion/desktop",
    "typecheck:legacy": "tsc -p apps/desktop/tsconfig.json --noEmit",
    "test:legacy": "vitest run"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "@types/node": "24.13.6",
    "rolldown": "1.2.9",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "ajv": "8.17.1",
    "yaml": "2.9.1"
  }
}
